generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String
  image     String?
  published Boolean @default(false)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  comments Comment[]

  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  posts Post[]
}

model Comment {
  id      Int    @id @default(autoincrement())
  content String

  postId Int
  post   Post @relation(fields: [postId], references: [id])
}

// Definisi Status Turnamen biar rapi dan nggak salah ketik
enum TournamentStatus {
  DRAFT       // Masih dikonsep, belum tayang
  UPCOMING    // Akan datang / Pendaftaran buka
  ONGOING     // Sedang berlangsung
  COMPLETED   // Sudah selesai
  CANCELED    // Dibatalkan
}

// Status Pertandingan
enum MatchStatus {
  SCHEDULED   // Belum dimulai
  ONGOING     // Sedang berlangsung
  DONE        // Sudah selesai
}

model Tournament {
  id              Int      @id @default(autoincrement())
  name            String   // Contoh: "Jakarta Pickleball Open 2026"
  slug            String   @unique // Untuk URL: "jakarta-pickleball-open-2026"
  description     String?  @db.Text // Deskripsi/Aturan lengkap (Bisa kosong/opsional)
  location        String   // Tempat pertandingan
  category        String?  // Contoh: "Ganda Putra Umum"
  image           String?
  // Waktu Pelaksanaan
  startDate       DateTime
  endDate         DateTime


  // Detail Tambahan
  registrationFee Int      @default(0) // Biaya daftar (pakai Int untuk Rupiah)
  prizePool       String?  // Total hadiah, misal: "Rp 50.000.000"
  maxParticipants Int      // Batas maksimal peserta/tim
  
  // Status turnamen menggunakan Enum di atas
  status          TournamentStatus @default(DRAFT)

  // Otomatis mencatat kapan data dibuat dan diupdate
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players         Player[]
  groups          TournamentGroup[]
  knockoutMatches KnockoutMatch[]
}

model Club {
  id          Int      @id @default(autoincrement())
  name        String   // Contoh: "Jakarta Pickleball Club"
  description String?  @db.Text // Deskripsi atau info jadwal latihan
  logo        String?  // Link gambar/logo klub
  location    String?  // Lokasi/Markas bermain
  contact     String?  // Nomor WA atau IG untuk dihubungi
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id          Int      @id @default(autoincrement())
  fullName    String   // Nama lengkap pemain
  schoolName  String   // Nama sekolah / instansi
  phoneNumber String   // No HP (Pakai String karena no HP bisa diawali '0' atau '+62') 
  
  category    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournamentId  Int
  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  
  seedOrder     Int?       // Urutan seed untuk seeding manual oleh admin
}

model Contact {
  id        String   @id @default(uuid())
  nama      String
  email     String
  pesan     String   @db.Text
  createdAt DateTime @default(now())
}

// ============================================================
// SISTEM BAGAN TURNAMEN — FASE GRUP (Round-Robin)
// ============================================================

// Grup dalam turnamen (misal: Grup A, Grup B, dst.)
model TournamentGroup {
  id              Int            @id @default(autoincrement())
  name            String         // "Grup A", "Grup B", dll.
  
  tournamentId    Int
  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  category        String         // Kategori: "single", "double", "double_mix"
  
  members         GroupMember[]
  matches         GroupMatch[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([tournamentId, category])
}

// Anggota/Pemain dalam grup
model GroupMember {
  id              Int              @id @default(autoincrement())
  
  groupId         Int
  group           TournamentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  playerName      String           // Nama pemain/tim
  seedOrder       Int              @default(0) // Urutan seed (diatur manual admin)
  
  // Statistik untuk ranking otomatis
  played          Int              @default(0) // Jumlah pertandingan dimainkan
  wins            Int              @default(0) // Menang
  losses          Int              @default(0) // Kalah
  pointsFor       Int              @default(0) // Poin yang dicetak
  pointsAgainst   Int              @default(0) // Poin yang diterima (kemasukan)
  pointDiff       Int              @default(0) // Selisih poin (pointsFor - pointsAgainst)
  rank            Int?                         // Peringkat akhir dalam grup
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([groupId])
}

// Pertandingan dalam grup (round-robin)
model GroupMatch {
  id              Int              @id @default(autoincrement())
  
  groupId         Int
  group           TournamentGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  player1Name     String           // Nama pemain 1
  player2Name     String           // Nama pemain 2
  score1          Int?             // Skor pemain 1
  score2          Int?             // Skor pemain 2
  winnerName      String?          // Nama pemenang (null jika belum selesai)
  
  status          MatchStatus      @default(SCHEDULED)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([groupId])
}

// ============================================================
// SISTEM BAGAN TURNAMEN — FASE GUGUR (Knockout)
// ============================================================

model KnockoutMatch {
  id              Int              @id @default(autoincrement())
  
  tournamentId    Int
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  category        String           // Kategori turnamen untuk mengaitkan bagan ini
  
  roundText       String           // Nama Ronde: "Perempat Final", "Semi Final", "Final"
  matchOrder      Int              // Urutannya di bracket (visual order)
  
  player1Name     String?          // Bisa diedit manual oleh admin / diisi otomatis saat generate
  player2Name     String?          
  score1          Int?
  score2          Int?
  winnerName      String?
  
  nextMatchId     Int?             // Mengarah ke Match ID ronde selanjutnya
  
  status          MatchStatus      @default(SCHEDULED)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([tournamentId, category])
}